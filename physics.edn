;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a record-keeping/logistics coordination robot
;; performs household labor scheduling, planting/harvest/yield-record logging
;; and seeds/tools supply-order coordination for subsistence crop farmers
;; (ISCO 6310). It never performs farm labor or makes agronomic decisions. Its
;; physical work is supply logistics: carrying delivered seed and tool bags
;; along the farm track from the road drop-off to the household store, and
;; lifting a seed bag onto the store shelf.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-6310"
 :cases
 [{:id :supplies-road-to-household-store
   :kind :transport
   :procedure "logistics robot carries delivered seed and tool bags 300 m along a dirt farm track from the road drop-off to the household store"
   :params {:mass-kg 50.0 :distance-m 300.0 :v-max-mps 0.8 :a-max-mps2 0.25
            :brake-decel-mps2 0.5 :drive-force-n 120.0 :crr 0.06
            :cog-height-m 0.45 :support-half-length-m 0.30}
   :sweep {:param :payload-kg :values [10.0 25.0 50.0 80.0 120.0]}
   :quantity :cycle-time-s
   :limit {:max 600.0 :basis "estimate: a delivery must be carried in within ~10 minutes per trip so bags are not left at the roadside unattended"}
   :boundary {:lo 2.0 :hi 300.0}}
  {:id :seed-bag-onto-store-shelf
   :kind :manipulator
   :procedure "arm lifts a seed bag from the robot's deck onto the household store shelf, off the floor and away from damp"
   :params {:l1-m 0.50 :l2-m 0.45 :m1-kg 5.0 :m2-kg 3.5
            :from [0.60 0.00] :to [0.30 0.75] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [2.0 5.0 10.0 15.0 25.0]}
   :quantity :peak-tau1-nm
   :limit {:max 120.0 :basis "estimate: continuous shoulder torque of a ~12 kg payload class arm"}
   :boundary {:lo 0.5 :hi 40.0}}]}
